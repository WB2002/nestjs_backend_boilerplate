{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "core/rate-limiter/backends/redis/lua/**/*.lua",
        "watchAssets": true
      },
      {
        "include": "core/feature-flag/lua/**/*.lua",
        "watchAssets": true
      }
    ]
  }
}
