# MongoDB
# - Use "mongo" when app runs in Docker and Mongo is a compose service (same network).
# - Use "host.docker.internal" when app runs in Docker and Mongo runs on your host machine.

# Auth
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL=900
SESSION_TTL=604800
COOKIE_SECRET=your-random-secret

MONGO_URI=mongodb://mongo:27017/nestjs-boilerplate
# MONGO_URI=mongodb://host.docker.internal:27017/nestjs-boilerplate
MONGO_PORT=27017

# Postgres (Commented out in docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=nestjs_db
POSTGRES_PORT=5432

# Redis (Commented out in docker-compose)
# Used by auth (revoked_jti:*), optional rate-limiter (rl:*), CacheModule when storage=Redis (cache:*),
# and feature flags (feature_flags:*).
REDIS_HOST=redis
REDIS_PORT=6379

# Feature flags
# Environment namespace for Redis keys (defaults to NODE_ENV, then development).
FEATURE_FLAG_ENV=development
# Periodic reconciliation interval in ms (default 45000). Minimum enforced: 5000.
FEATURE_FLAG_RECONCILE_MS=45000
# Comma-separated emails that receive admin role (flag management permissions).
FEATURE_FLAG_ADMIN_EMAILS=
# Set to false to disable CloudWatch EMF metrics for feature flags.
FEATURE_FLAG_METRICS=true

# Application
PORT=3000

# Request deadline / cancellation
# Default per-request timeout when x-request-timeout-ms is absent.
REQUEST_TIMEOUT_MS=30000
# Hard cap for header, route @RequestTimeout, and default.
REQUEST_TIMEOUT_MAX_MS=120000

# Graceful shutdown
# Point ALB/target-group health checks at GET /health/ready (not /health).
# Set ALB deregistration delay >= SHUTDOWN_DRAIN_MS so traffic stops before close.
SHUTDOWN_DRAIN_MS=10000
SHUTDOWN_FORCE_MS=5000

# Rate limiting / client IP
# Production (ALB → EC2): TRUST_PROXY=true so req.ip is the original client IP.
# Local/dev (no ALB): leave false/unset so X-Forwarded-For cannot be spoofed.
TRUST_PROXY=false

# Uploads (POST /uploads, multipart field "files")
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE=5000000
UPLOAD_MAX_TOTAL_SIZE=20000000
# Set true to scan with ClamAV (fail closed if clamd unreachable)
UPLOAD_VIRUS_SCAN=false
# ClamAV is reachable only on the compose network (no host port). Use service name:
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Outbound HTTP client SSRF
# Set true only for internal mesh / local tests that call private/loopback hosts.
# Leave unset/false in production so assertPublicHttpUrl blocks private IPs.
# HTTP_CLIENT_ALLOW_PRIVATE_URLS=false
