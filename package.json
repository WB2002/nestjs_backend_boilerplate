  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r ./dist/instrumentation.js dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "lint:staged": "lint-staged",
    "secrets:scan": "./scripts/gitleaks-pre-commit.sh",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchman=false --config jest.config.ts",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --config jest.config.ts",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchman=false --config jest.config.ts --testPathIgnorePatterns=integration.spec",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchman=false --runInBand --config jest.integration.config.ts --testPathPatterns=integration.spec",
    "smoke:shutdown": "./scripts/smoke-graceful-shutdown.sh",
    "prepare": "husky",
    "quality": "pnpm quality:lint && pnpm quality:types && pnpm quality:unit && pnpm quality:integration && pnpm quality:property && pnpm quality:contract && pnpm quality:mutation && pnpm quality:supply-chain",
    "quality:lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "quality:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tsd-emit.json && tsd --files test/type/overload-utilization.test-d.ts --typings .tsd-emit/core/overload/priority/should-shed-priority-request.d.ts",
    "quality:unit": "pnpm test:unit",
    "quality:integration": "pnpm test:integration",
    "quality:property": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchman=false -c jest.property.config.ts",
    "quality:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchman=false -c jest.contract.config.ts",
    "quality:mutation": "./scripts/ci/run-mutation.sh",
    "quality:contract:update-snapshot": "./scripts/ci/merge-graphql-sdl.sh > test/contracts/graphql/schema.snapshot.graphql",
    "quality:supply-chain": "pnpm install --frozen-lockfile && ./scripts/ci/run-pnpm-audit.sh && ./scripts/ci/run-trivy.sh"
  },
