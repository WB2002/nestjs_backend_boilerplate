{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "rootDir": "./",
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "jest.config.ts",
    "jest.integration.config.ts",
    "jest.property.config.ts",
    "jest.contract.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
